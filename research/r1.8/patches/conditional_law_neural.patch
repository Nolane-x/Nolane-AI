+    def conditional_law_scores(
+        self,
+        state_sketch: Tensor,
+        context_fingerprint: Tensor,
+        action_embeddings: Tensor,
+        evidence_effects: Tensor,
+        evidence_meta: Tensor,
+    ) -> dict[str, Tensor]:
+        """Predict context-conditioned public action effects.
+
+        This method is a world-model API only.  R1.8 does not add its output to
+        policy logits until a later closed-loop gate proves that the learned law
+        representation is useful for control.
+        """
+        if state_sketch.ndim != 2 or state_sketch.shape[-1] != self.psr_sketch_dim:
+            raise ValueError("state_sketch must have shape [batch, psr_sketch_dim]")
+        batch = state_sketch.shape[0]
+        if tuple(context_fingerprint.shape) != (batch, self.conditional_law_context_dim):
+            raise ValueError("context_fingerprint must have shape [batch, conditional_law_context_dim]")
+        if action_embeddings.ndim != 3 or action_embeddings.shape[0] != batch or action_embeddings.shape[-1] != self.workspace_dim:
+            raise ValueError("action_embeddings must have shape [batch, actions, workspace_dim]")
+        actions = action_embeddings.shape[1]
+        if tuple(evidence_effects.shape) != (batch, actions, self.psr_sketch_dim):
+            raise ValueError("evidence_effects must have shape [batch, actions, psr_sketch_dim]")
+        if tuple(evidence_meta.shape) != (batch, actions, 3):
+            raise ValueError("evidence_meta must have shape [batch, actions, 3]")
+
+        state = torch.tanh(self.conditional_law_state_projection(state_sketch))
+        context = torch.tanh(self.conditional_law_context_projection(context_fingerprint))
+        action = torch.tanh(self.conditional_law_action_projection(action_embeddings))
+        evidence = torch.tanh(self.conditional_law_evidence_projection(evidence_effects))
+        meta = self.conditional_law_meta_projection(evidence_meta)
+        state = state.unsqueeze(1).expand(-1, actions, -1)
+        context = context.unsqueeze(1).expand(-1, actions, -1)
+        relation = torch.cat(
+            (
+                state,
+                context,
+                action,
+                evidence,
+                state * evidence,
+                torch.abs(state - evidence),
+                meta,
+            ),
+            dim=-1,
+        )
+        hidden = self.conditional_law_relation(relation)
+        predicted_effect = 4.0 * torch.tanh(self.conditional_law_effect_head(hidden))
+        confidence = torch.sigmoid(self.conditional_law_confidence_head(hidden)).squeeze(-1)
+        return {
+            "predicted_effect": predicted_effect,
+            "confidence": confidence,
+            "hidden": hidden,
+        }
