+    def conditional_reliability_scores(self, conditional_hidden, predicted_control, evidence_control, evidence_meta):
+        # Shared per-action nonlinear runtime certificate.  Input is 451D:
+        # hidden256 + predicted64 + evidence64 + |pred-evidence|64 + meta3.
+        features = torch.cat((conditional_hidden, predicted_control, evidence_control,
+                              torch.abs(predicted_control-evidence_control), evidence_meta), dim=-1)
+        logits = self.conditional_reliability_head(features).squeeze(-1)
+        seen = evidence_meta[..., 0].gt(0).to(logits.dtype)
+        return {"logits": logits, "score": seen * torch.sigmoid(logits), "features": features}
