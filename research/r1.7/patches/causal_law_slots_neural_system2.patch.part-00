+
+    def init_causal_law_state(
+        self,
+        *,
+        batch_size: int,
+        device: torch.device | None = None,
+        dtype: torch.dtype | None = None,
+    ) -> CausalLawState:
+        if int(batch_size) < 1:
+            raise ValueError("batch_size must be positive")
+        if dtype is None:
+            dtype = self.causal_law_seed_slots.dtype
+        slots = self.causal_law_seed_slots.to(device=device, dtype=dtype).unsqueeze(0)
+        slots = slots.expand(int(batch_size), -1, -1).clone()
+        confidence = torch.zeros(
+            int(batch_size), self.causal_law_slot_count, device=device, dtype=dtype
+        )
+        usage = torch.zeros_like(confidence)
+        return CausalLawState(slots=slots, confidence=confidence, usage=usage)
+
+    def update_causal_laws(
+        self,
+        state_sketch: Tensor,
+        action_embeddings: Tensor,
+        action_index: int | Tensor,
+        observed_delta: Tensor,
+        law_state: CausalLawState,
+    ) -> CausalLawState:
+        if state_sketch.ndim != 2 or state_sketch.shape[-1] != self.psr_sketch_dim:
+            raise ValueError("state_sketch must have shape [batch, psr_sketch_dim]")
+        if (
+            action_embeddings.ndim != 3
+            or action_embeddings.shape[0] != state_sketch.shape[0]
+            or action_embeddings.shape[-1] != self.workspace_dim
+        ):
+            raise ValueError(
+                "action_embeddings must have shape [batch, actions, workspace_dim]"
+            )
+        if observed_delta.shape != state_sketch.shape:
+            raise ValueError("observed_delta must match state_sketch")
+        batch, action_count, _ = action_embeddings.shape
+        if isinstance(action_index, int):
+            action_ids = torch.full(
+                (batch,), int(action_index), device=state_sketch.device, dtype=torch.long
+            )
