         # sketches. Unlike free latent recursion, this state space has explicit
         # simulator-supervised successor targets for every train/dev action.
         self.psr_sketch_dim = 128
+
+        # R1.7 content-addressed Causal Law Slots.  These recurrent hypotheses
+        # bind a public pre-action state, dynamic action representation, and
+        # observed structured successor delta.  They are global slots rather
+        # than fixed action-index memories; action identity enters only through
+        # the shared action embedding, preserving permutation equivariance.
+        self.causal_law_slot_count = 8
+        self.causal_law_dim = 256
+        self.causal_law_seed_slots = nn.Parameter(
+            torch.empty(self.causal_law_slot_count, self.causal_law_dim)
+        )
+        nn.init.normal_(self.causal_law_seed_slots, mean=0.0, std=0.02)
+        self.causal_law_state_projection = nn.Linear(
+            self.psr_sketch_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_action_projection = nn.Linear(
+            workspace_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_effect_projection = nn.Linear(
+            self.psr_sketch_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_evidence_projection = nn.Sequential(
+            nn.Linear(self.causal_law_dim * 3, self.causal_law_dim),
+            nn.GELU(),
+            nn.LayerNorm(self.causal_law_dim),
+        )
+        self.causal_law_address_query = nn.Linear(
+            self.causal_law_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_address_key = nn.Linear(
+            self.causal_law_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_update = nn.GRUCell(self.causal_law_dim, self.causal_law_dim)
+        self.causal_law_retrieval_query = nn.Linear(
+            self.causal_law_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_retrieval_key = nn.Linear(
+            self.causal_law_dim, self.causal_law_dim, bias=False
+        )
+        self.causal_law_delta_head = nn.Linear(
+            self.causal_law_dim, self.psr_sketch_dim
+        )
+        self.causal_law_policy_head = nn.Sequential(
+            nn.Linear(self.causal_law_dim * 4, self.causal_law_dim),
+            nn.GELU(),
+            nn.LayerNorm(self.causal_law_dim),
+            nn.Linear(self.causal_law_dim, 1),
+        )
+        self.causal_law_policy_scale = nn.Parameter(torch.tensor(0.0))
+
         self.psr_dim = 256
