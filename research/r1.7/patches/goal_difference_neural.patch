+    def goal_difference_scores(
+        self,
+        structured_atoms: Tensor,
+        structured_mask: Tensor,
+        predicted_deltas: Tensor,
+        action_embeddings: Tensor,
+        confidence: Tensor,
+    ) -> dict[str, Tensor]:
+        """Score predicted action effects against learned public goal evidence.
+
+        The two role queries are deliberately field-name agnostic. They attend
+        over the same structured atoms but can specialize into current-like and
+        target-like evidence. Action ordering enters only through the shared
+        delta/action branches, preserving permutation equivariance.
+        """
+        if structured_atoms.ndim != 3 or structured_atoms.shape[-1] != self.structured_atom_dim:
+            raise ValueError("structured_atoms must have shape [batch, atoms, structured_atom_dim]")
+        if structured_mask.shape != structured_atoms.shape[:2]:
+            raise ValueError("structured_mask must match [batch, atoms]")
+        if structured_mask.dtype != torch.bool:
+            structured_mask = structured_mask.to(torch.bool)
+        if bool((~structured_mask.any(dim=1)).any().item()):
+            raise ValueError("every structured observation requires at least one atom")
+        batch = structured_atoms.shape[0]
+        if predicted_deltas.ndim != 3 or predicted_deltas.shape[0] != batch or predicted_deltas.shape[-1] != self.psr_sketch_dim:
+            raise ValueError("predicted_deltas must have shape [batch, actions, psr_sketch_dim]")
+        actions = predicted_deltas.shape[1]
+        if tuple(action_embeddings.shape) != (batch, actions, self.workspace_dim):
+            raise ValueError("action_embeddings must have shape [batch, actions, workspace_dim]")
+        if tuple(confidence.shape) != (batch, actions):
+            raise ValueError("confidence must have shape [batch, actions]")
+
+        keys = self.goal_difference_atom_key(structured_atoms)
+        scale = math.sqrt(self.goal_difference_dim)
+        current_logits = torch.einsum("bnd,d->bn", keys, self.goal_difference_current_query) / scale
+        target_logits = torch.einsum("bnd,d->bn", keys, self.goal_difference_target_query) / scale
+        current_logits = current_logits.masked_fill(~structured_mask, -1e9)
+        target_logits = target_logits.masked_fill(~structured_mask, -1e9)
+        current_attention = torch.softmax(current_logits, dim=-1)
+        target_attention = torch.softmax(target_logits, dim=-1)
+        current = torch.einsum("bn,bnd->bd", current_attention, structured_atoms)
+        target = torch.einsum("bn,bnd->bd", target_attention, structured_atoms)
+        goal_context = self.goal_difference_context(torch.cat((current, target, target-current, torch.abs(target-current)), dim=-1))
+
+        effect = torch.tanh(self.goal_difference_delta_projection(predicted_deltas))
+        action = torch.tanh(self.goal_difference_action_projection(action_embeddings))
+        goal = goal_context.unsqueeze(1).expand(-1, actions, -1)
+        relation = torch.cat((goal, effect, goal*effect, torch.abs(goal-effect), action), dim=-1)
+        raw_progress = self.goal_difference_scorer(relation).squeeze(-1)
+        predicted_progress = torch.tanh(raw_progress) * confidence.clamp(0.0, 1.0)
+        policy_bonus = torch.tanh(self.goal_difference_policy_scale) * predicted_progress
+        return {
+            "predicted_progress": predicted_progress,
+            "policy_bonus": policy_bonus,
+            "current_attention": current_attention,
+            "target_attention": target_attention,
+        }
+
