+        if action_ids.shape != (batch,):
+            raise ValueError("action_index must be scalar or shape [batch]")
+        if bool(((action_ids < 0) | (action_ids >= action_count)).any().item()):
+            raise ValueError("action_index out of range")
+        expected_slots = (batch, self.causal_law_slot_count, self.causal_law_dim)
+        expected_meta = (batch, self.causal_law_slot_count)
+        if tuple(law_state.slots.shape) != expected_slots:
+            raise ValueError(f"law slots must have shape {expected_slots}")
+        if tuple(law_state.confidence.shape) != expected_meta:
+            raise ValueError(f"law confidence must have shape {expected_meta}")
