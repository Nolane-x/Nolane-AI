+        raw_bonus = self.causal_law_policy_head(relation).squeeze(-1)
+        policy_bonus = (
+            torch.tanh(self.causal_law_policy_scale) * confidence * raw_bonus
+        )
+        return {
+            "predicted_delta": predicted_delta,
+            "confidence": confidence,
+            "policy_bonus": policy_bonus,
+            "slot_attention": weights,
+        }
 
