+    @staticmethod
+    def _immutable_metadata_projection(metadata: LearningMemoryMetadata) -> dict[str, Any]:
+        state = metadata.to_state()
+        state.pop("epistemic_type", None)
+        state.pop("source_refs", None)
+        state.pop("last_verified_ref", None)
+        return state
